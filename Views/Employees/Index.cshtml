@model List<Employee>
@{
    ViewData["Title"] = "Pracownicy";
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Pracownicy</h1>
    <a asp-action="Create" class="btn btn-primary">Dodaj pracownika</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />
    <div class="col-md-5">
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control"
               placeholder="Szukaj po imieniu, nazwisku lub e-mailu" />
    </div>
    <div class="col-md-4">
        <select name="departmentId" asp-items="ViewBag.Departments" class="form-select">
            <option value="">Wszystkie działy</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Filtruj</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Wyczyść</a>
    </div>
</form>

<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSort"
                       asp-route-searchString="@ViewBag.SearchString" asp-route-departmentId="@ViewBag.DepartmentId">Pracownik</a>
                </th>
                <th>Dział</th>
                <th>Stanowisko</th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewBag.DateSort"
                       asp-route-searchString="@ViewBag.SearchString" asp-route-departmentId="@ViewBag.DepartmentId">Zatrudniony</a>
                </th>
                <th class="text-end">
                    <a asp-action="Index" asp-route-sortOrder="@ViewBag.SalarySort"
                       asp-route-searchString="@ViewBag.SearchString" asp-route-departmentId="@ViewBag.DepartmentId">Wynagrodzenie</a>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Brak pracowników spełniających kryteria.</td></tr>
            }
            @foreach (var e in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@e.Id" class="fw-semibold text-decoration-none">@e.LastName @e.FirstName</a>
                        @if (!e.IsActive)
                        {
                            <span class="badge bg-secondary ms-1">nieaktywny</span>
                        }
                        <div class="small text-muted">@e.Email</div>
                    </td>
                    <td><a asp-controller="Departments" asp-action="Details" asp-route-id="@e.DepartmentId">@e.Department?.Name</a></td>
                    <td>@e.Position?.Title</td>
                    <td>@e.HireDate.ToString("dd.MM.yyyy")</td>
                    <td class="text-end">@e.Salary.ToString("N2") zł</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">Szczegóły</a>
                        <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Edytuj</a>
                        <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-sm btn-outline-danger">Usuń</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">Strona @page z @totalPages · wyników: @ViewBag.Total</span>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-route-page="@(page - 1)" asp-route-sortOrder="@ViewBag.SortOrder"
           asp-route-searchString="@ViewBag.SearchString" asp-route-departmentId="@ViewBag.DepartmentId"
           class="btn btn-outline-secondary @(page <= 1 ? "disabled" : "")">Poprzednia</a>
        <a asp-action="Index" asp-route-page="@(page + 1)" asp-route-sortOrder="@ViewBag.SortOrder"
           asp-route-searchString="@ViewBag.SearchString" asp-route-departmentId="@ViewBag.DepartmentId"
           class="btn btn-outline-secondary @(page >= totalPages ? "disabled" : "")">Następna</a>
    </div>
</div>
