@model Department
@{
    ViewData["Title"] = "Nowy dział";
}

<h1 class="h3 mb-3">Nowy dział</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <partial name="_Form" />
            <button type="submit" class="btn btn-primary">Zapisz</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
        </form>
    </div>
</div>
