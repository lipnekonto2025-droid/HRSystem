@model Department
@{
    ViewData["Title"] = Model.Name;
    var active = Model.Employees.Where(e => e.IsActive).ToList();
    var avg = active.Any() ? active.Average(e => e.Salary) : 0m;
    var payroll = active.Sum(e => e.Salary);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.Name</h1>
        <div class="text-muted">@Model.Location</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edytuj</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Wróć do listy</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card text-center"><div class="card-body">
        <div class="h3 mb-0">@active.Count</div><div class="text-muted">Aktywni pracownicy</div>
    </div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body">
        <div class="h3 mb-0">@avg.ToString("N2") zł</div><div class="text-muted">Średnie wynagrodzenie</div>
    </div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body">
        <div class="h3 mb-0">@payroll.ToString("N2") zł</div><div class="text-muted">Miesięczny fundusz płac</div>
    </div></div></div>
</div>

<h2 class="h5">Pracownicy działu</h2>
<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr><th>Pracownik</th><th>Stanowisko</th><th>Zatrudniony</th><th class="text-end">Wynagrodzenie</th></tr>
        </thead>
        <tbody>
            @if (!Model.Employees.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-3">W tym dziale nie ma jeszcze pracowników.</td></tr>
            }
            @foreach (var e in Model.Employees.OrderBy(x => x.LastName).ThenBy(x => x.FirstName))
            {
                <tr>
                    <td>
                        <a asp-controller="Employees" asp-action="Details" asp-route-id="@e.Id" class="text-decoration-none">@e.LastName @e.FirstName</a>
                        @if (!e.IsActive)
                        {
                            <span class="badge bg-secondary ms-1">nieaktywny</span>
                        }
                    </td>
                    <td>@e.Position?.Title</td>
                    <td>@e.HireDate.ToString("dd.MM.yyyy")</td>
                    <td class="text-end">@e.Salary.ToString("N2") zł</td>
                </tr>
            }
        </tbody>
    </table>
</div>
