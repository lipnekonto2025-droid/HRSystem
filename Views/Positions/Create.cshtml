@model Position
@{
    ViewData["Title"] = "Nowe stanowisko";
}

<h1 class="h3 mb-3">Nowe stanowisko</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MinSalary" class="form-label"></label>
                    <input asp-for="MinSalary" type="text" inputmode="decimal" class="form-control" />
                    <span asp-validation-for="MinSalary" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MaxSalary" class="form-label"></label>
                    <input asp-for="MaxSalary" type="text" inputmode="decimal" class="form-control" />
                    <span asp-validation-for="MaxSalary" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Zapisz</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
        </form>
    </div>
</div>
