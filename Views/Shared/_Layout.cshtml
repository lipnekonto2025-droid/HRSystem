@{
    string Active(string controller) =>
        ViewContext.RouteData.Values["controller"]?.ToString() == controller ? "active" : "";
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – HR System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">HR System</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link @Active("Employees")" asp-controller="Employees" asp-action="Index">Pracownicy</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Departments")" asp-controller="Departments" asp-action="Index">Działy</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Positions")" asp-controller="Positions" asp-action="Index">Stanowiska</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Leaves")" asp-controller="Leaves" asp-action="Index">Urlopy</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Statistics")" asp-controller="Statistics" asp-action="Index">Statystyki</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-muted small pb-4">System zarządzania pracownikami · ASP.NET Core MVC + Entity Framework Core</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
